@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = Model.IsStaff ? "Review and manage artist claims" : "Your claims at a glance";

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    var firstName = Model.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? Model.DisplayName;

    int Pct(decimal value) => Model.TotalValue <= 0 ? 0 : (int)Math.Round(value / Model.TotalValue * 100);
    var approvedPct = Pct(Model.ApprovedValue);
    var pendingPct = Pct(Model.PendingValue);
    var declinedPct = Pct(Model.DeclinedValue);

    string ActionLabel(string action) => action switch
    {
        "Create" => "created claim",
        "Update" => "updated claim",
        "Submit" => "submitted claim",
        "Resubmit" => "resubmitted claim",
        "Accept" => "accepted claim",
        "Decline" => "declined claim",
        "Correction" => "requested a correction on claim",
        "Report" => "generated report",
        "DocumentUpload" => "attached a document to claim",
        "DocumentDelete" => "removed a document from claim",
        "UserCreate" => "created artist account",
        "UserUpdate" => "updated artist account",
        "UserActivate" => "reactivated artist account",
        "UserDeactivate" => "deactivated artist account",
        "ProgrammeCreate" => "added programme",
        "ProgrammeUpdate" => "updated programme",
        "Login" => "signed in",
        "LoginFailed" => "had a failed sign-in",
        "PasswordChange" => "changed their password",
        _ => action
    };

    bool HasReference(string action) =>
        action is not ("Login" or "LoginFailed" or "PasswordChange");
}

<div class="page-head">
    <div>
        <span class="eyebrow">@Formatting.Date(DateTime.Today)</span>
        <h2>@greeting, @firstName</h2>
        <p>
            @(Model.IsStaff
                ? "Here is what needs your attention across the claims workspace."
                : "Track your submissions and act on any corrections from the Secretary.")
        </p>
    </div>
    <div class="page-head-actions">
        @if (Model.IsStaff)
        {
            <a class="btn btn-primary" asp-controller="Claims" asp-action="Index" asp-route-scope="review">
                @Html.Raw(Icons.Svg("inbox", 16)) Review queue
            </a>
            <a class="btn btn-secondary" asp-controller="Reports" asp-action="Index">
                @Html.Raw(Icons.Svg("download", 16)) Reports
            </a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Claims" asp-action="New">
                @Html.Raw(Icons.Svg("plus", 16)) New claim
            </a>
        }
    </div>
</div>

@if (!Model.IsStaff && Model.AwaitingArtist > 0)
{
    <div class="banner warn">
        <div class="banner-icon">@Html.Raw(Icons.Svg("alert", 17))</div>
        <div>
            <h4>@Model.AwaitingArtist claim@(Model.AwaitingArtist == 1 ? "" : "s") need@(Model.AwaitingArtist == 1 ? "s" : "") your correction</h4>
            <p>The Secretary has returned a claim with comments. Open it, apply the corrections and resubmit.</p>
        </div>
        <a class="btn btn-warn btn-sm" style="margin-left:auto" asp-controller="Claims" asp-action="Index" asp-route-scope="corrections">Review corrections</a>
    </div>
}

<div class="stat-grid">
    <div class="stat">
        <div class="stat-icon">@Html.Raw(Icons.Svg(Model.IsStaff ? "inbox" : "file", 17))</div>
        <div class="stat-label">@(Model.IsStaff ? "Awaiting review" : "My claims")</div>
        <div class="stat-value">@(Model.IsStaff ? Model.AwaitingReview : Model.TotalClaims)</div>
        <div class="stat-sub">@(Model.IsStaff ? "Submitted and resubmitted claims" : $"{Model.Drafts} draft, {Model.Accepted} accepted")</div>
    </div>
    <div class="stat warn">
        <div class="stat-icon">@Html.Raw(Icons.Svg("alert", 17))</div>
        <div class="stat-label">Needs correction</div>
        <div class="stat-value">@Model.AwaitingArtist</div>
        <div class="stat-sub">@(Model.IsStaff ? "Waiting on the artist" : "Returned by the Secretary")</div>
    </div>
    <div class="stat success">
        <div class="stat-icon">@Html.Raw(Icons.Svg("check", 17))</div>
        <div class="stat-label">Approved claims</div>
        <div class="stat-value">@Model.Accepted</div>
        <div class="stat-sub">@Formatting.Money(Model.ApprovedValue) approved</div>
    </div>
    <div class="stat @(Model.IsStaff ? "violet" : "")">
        <div class="stat-icon">@Html.Raw(Icons.Svg(Model.IsStaff ? "users" : "money", 17))</div>
        <div class="stat-label">@(Model.IsStaff ? "Active artists" : "Total claim value")</div>
        @if (Model.IsStaff)
        {
            <div class="stat-value">@Model.ActiveArtists</div>
            <div class="stat-sub">@Model.ActiveProgrammes active programmes</div>
        }
        else
        {
            <div class="stat-value money">@Formatting.Money(Model.TotalValue)</div>
            <div class="stat-sub">Across @Model.TotalClaims claim@(Model.TotalClaims == 1 ? "" : "s")</div>
        }
    </div>
</div>

<div class="mini-strip">
    <div class="mini-item">
        <div class="mini-label">Drafts</div>
        <div class="mini-value">@Model.Drafts</div>
    </div>
    <div class="mini-item">
        <div class="mini-label">Declined</div>
        <div class="mini-value">@Model.Declined</div>
    </div>
    <div class="mini-item">
        <div class="mini-label">Documents</div>
        <div class="mini-value">@Model.Documents</div>
    </div>
    <div class="mini-item">
        <div class="mini-label">@(Model.IsStaff ? "Reports generated" : "Reports available")</div>
        <div class="mini-value">@Model.ReportsGenerated</div>
    </div>
</div>

<div class="detail-grid">
    <div class="detail-main">
        <div class="card">
            <div class="card-head">
                <div>
                    <h3>@(Model.IsStaff ? "Needs your attention" : "Needs attention")</h3>
                    <p>@(Model.IsStaff ? "Oldest submissions waiting for review, plus claims with the artist." : "Claims returned for correction by the Secretary.")</p>
                </div>
                <a class="link-arrow" asp-controller="Claims" asp-action="Index" asp-route-scope="@(Model.IsStaff ? "review" : "corrections")">View all @Html.Raw(Icons.Svg("arrow-right", 14))</a>
            </div>

            @if (Model.NeedsAttention.Count == 0)
            {
                <div class="empty">
                    <div class="empty-icon">@Html.Raw(Icons.Svg("check", 24))</div>
                    <h3>Nothing is waiting</h3>
                    <p>@(Model.IsStaff ? "There are no claims waiting for review right now." : "No corrections have been requested on your claims.")</p>
                </div>
            }
            else
            {
                <div class="card-body tight">
                    <ul class="list-clean" style="padding: 0 20px;">
                        @foreach (var claim in Model.NeedsAttention)
                        {
                            <li class="list-row">
                                <div class="doc-icon">@Html.Raw(Icons.Svg("file", 15))</div>
                                <div class="grow">
                                    <div class="list-title">
                                        <a asp-controller="Claims" asp-action="Details" asp-route-id="@claim.ClaimId">@claim.Reference</a>
                                        <span class="muted small">• @claim.ProgrammeTitle</span>
                                    </div>
                                    <div class="list-sub">
                                        @if (Model.IsStaff)
                                        {
                                            <span>@claim.ClaimantName • @Formatting.Ago(claim.SubmittedAt)</span>
                                        }
                                        else
                                        {
                                            <span>Returned @Formatting.Ago(claim.SubmittedAt) • @claim.ItemCount work record@(claim.ItemCount == 1 ? "" : "s")</span>
                                        }
                                    </div>
                                </div>
                                <span class="amount">@Formatting.Money(claim.Amount)</span>
                                <span class="status @ClaimStatusNames.Slug(claim.Status)">@claim.Status</span>
                                <a class="btn btn-secondary btn-sm" asp-controller="Claims" asp-action="Details" asp-route-id="@claim.ClaimId">
                                    @(Model.IsStaff ? "Review" : "Open")
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-head">
                <div>
                    <h3>Recent claims</h3>
                    <p>The latest activity in @(Model.IsStaff ? "the claims workspace" : "your claim history").</p>
                </div>
                <a class="link-arrow" asp-controller="Claims" asp-action="Index">Open claims @Html.Raw(Icons.Svg("arrow-right", 14))</a>
            </div>

            @if (Model.RecentClaims.Count == 0)
            {
                <div class="empty">
                    <div class="empty-icon">@Html.Raw(Icons.Svg("file", 24))</div>
                    <h3>No claims yet</h3>
                    <p>@(Model.IsStaff ? "Artist claims will appear here as soon as they are submitted." : "Create your first claim to get started.")</p>
                    @if (!Model.IsStaff)
                    {
                        <a class="btn btn-primary" asp-controller="Claims" asp-action="New">Create a claim</a>
                    }
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                            <tr>
                                <th>Claim</th>
                                @if (Model.IsStaff)
                                {
                                    <th>Artist</th>
                                }
                                <th>Programme</th>
                                <th class="right">Amount</th>
                                <th>Status</th>
                                <th>Updated</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model.RecentClaims)
                            {
                                <tr>
                                    <td>
                                        <a class="table-link" asp-controller="Claims" asp-action="Details" asp-route-id="@claim.ClaimId">@claim.Reference</a>
                                        <div class="cell-sub">@Formatting.Date(claim.ClaimDate)</div>
                                    </td>
                                    @if (Model.IsStaff)
                                    {
                                        <td>@claim.ClaimantName</td>
                                    }
                                    <td class="small">@claim.ProgrammeTitle</td>
                                    <td class="right amount">@Formatting.Money(claim.Amount)</td>
                                    <td><span class="status @ClaimStatusNames.Slug(claim.Status)">@claim.Status</span></td>
                                    <td class="small muted">@Formatting.Ago(claim.SubmittedAt ?? claim.CreatedAt)</td>
                                    <td class="cell-actions">
                                        <a class="btn btn-ghost btn-sm" asp-controller="Claims" asp-action="Details" asp-route-id="@claim.ClaimId">Open</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="detail-side">
        @if (Model.IsStaff)
        {
            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>Recent activity</h3>
                        <p>Actions recorded in the audit log.</p>
                    </div>
                    <a class="link-arrow" asp-controller="Audit" asp-action="Index">Audit log</a>
                </div>
                <div class="card-body">
                    @if (Model.RecentActivity.Count == 0)
                    {
                        <p class="note">No activity has been recorded yet.</p>
                    }
                    else
                    {
                        <div class="feed">
                            @foreach (var entry in Model.RecentActivity)
                            {
                                <div class="feed-item">
                                    <div class="feed-dot">
                                        @Html.Raw(Icons.Svg(entry.ActionType is "Decline" or "LoginFailed" ? "alert" : entry.ActionType is "Accept" or "Report" ? "check" : "activity", 14))
                                    </div>
                                    <div>
                                        <div class="feed-text">
                                            <span class="strong">@(entry.User?.FullName ?? "System")</span>
                                            @ActionLabel(entry.ActionType)@(HasReference(entry.ActionType) && entry.RecordID is int record ? $" #{record:D3}" : "")
                                        </div>
                                        <div class="feed-time">@Formatting.Ago(entry.ActionDate)</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>Claim value</h3>
                        <p>How your claimed work has been processed.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="value-split">
                        <div class="value-row">
                            <span class="swatch" style="background:#0F7A4D"></span>
                            <span class="v-label">Approved</span>
                            <span class="v-amount">@Formatting.Money(Model.ApprovedValue)</span>
                        </div>
                        <div class="value-row">
                            <span class="swatch" style="background:#B45309"></span>
                            <span class="v-label">In progress</span>
                            <span class="v-amount">@Formatting.Money(Model.PendingValue)</span>
                        </div>
                        <div class="value-row">
                            <span class="swatch" style="background:#B42318"></span>
                            <span class="v-label">Declined</span>
                            <span class="v-amount">@Formatting.Money(Model.DeclinedValue)</span>
                        </div>
                    </div>
                    <div class="bar mt-2" aria-hidden="true">
                        <span style="width:@approvedPct%; background:#0F7A4D"></span>
                        <span style="width:@pendingPct%; background:#E7A33E"></span>
                        <span style="width:@declinedPct%; background:#D9635B"></span>
                    </div>
                    <p class="note mt-2">Totals include all claims you have created, across every status.</p>
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>Quick actions</h3>
                        <p>Jump straight to the work you need.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="quick-actions">
                        <a class="quick-action" asp-controller="Claims" asp-action="New">
                            <span class="qa-icon">@Html.Raw(Icons.Svg("plus", 16))</span>
                            <span class="qa-label">New claim</span>
                            <span class="qa-sub">Capture work records and submit</span>
                        </a>
                        <a class="quick-action" asp-controller="Claims" asp-action="Index">
                            <span class="qa-icon">@Html.Raw(Icons.Svg("file", 16))</span>
                            <span class="qa-label">My claims</span>
                            <span class="qa-sub">Search, filter and track status</span>
                        </a>
                        <a class="quick-action" asp-controller="Claims" asp-action="Index" asp-route-scope="corrections">
                            <span class="qa-icon">@Html.Raw(Icons.Svg("alert", 16))</span>
                            <span class="qa-label">Corrections</span>
                            <span class="qa-sub">@Model.AwaitingArtist awaiting your action</span>
                        </a>
                        <a class="quick-action" asp-controller="Account" asp-action="Profile">
                            <span class="qa-icon">@Html.Raw(Icons.Svg("user", 16))</span>
                            <span class="qa-label">My profile</span>
                            <span class="qa-sub">Banking details and password</span>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
